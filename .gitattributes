# Normalize line endings to LF for all text files, regardless of the
# checkout platform's core.autocrlf setting. Prevents Prettier/ESLint from
# flagging every file as unformatted on Windows checkouts.
* text=auto eol=lf

# Binary assets — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
