---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Τομείς Δραστηριότητας — QBEE',
  description:
    'QBEE: ανάπτυξη και διαχείριση ακινήτων και στρατηγικές συμμετοχές στη Θεσσαλονίκη και τη Βόρεια Ελλάδα.',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <HeroText
    tagline="Τομείς"
    title="Τομείς Δραστηριότητας"
    subtitle="Δραστηριοποιούμαστε σε δύο τομείς με κοινή φιλοσοφία: μακροπρόθεσμη αξία, ελεγχόμενος κίνδυνος και μελετημένη απόφαση."
  />

  <!-- Δύο τομείς — overview grid -->
  <Features
    columns={2}
    items={[
      {
        title: 'Ανάπτυξη & Διαχείριση Ακινήτων',
        description:
          'Αγοράζουμε οικόπεδα, αναπτύσσουμε και διαχειριζόμαστε ακίνητα που μπορούν να παράγουν σταθερό εισόδημα. Κάθε έργο αξιολογείται με συντηρητικές παραδοχές, ξεκάθαρη στρατηγική και σαφές πλάνο πριν δεσμευτεί οποιοδήποτε κεφάλαιο.',
        icon: 'tabler:building-estate',
      },
      {
        title: 'Στρατηγικές Συμμετοχές',
        description:
          'Συμμετέχουμε επιλεκτικά σε εταιρίες εκτός του κύριου αντικειμένου μας, όταν η δομή, η διοίκηση και οι προοπτικές δικαιολογούν μακροπρόθεσμη δέσμευση.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- ── Τομέας 1: Ακίνητα ── -->
  <Content
    isReversed
    tagline="Τομέας 1"
    title="Ανάπτυξη & Διαχείριση Ακινήτων"
    items={[
      {
        title: 'Απόκτηση & Ανάπτυξη',
        description:
          'Αγοράζουμε οικόπεδα και ακίνητα με προοπτική ανάπτυξης σε περιοχές που γνωρίζουμε καλά, κυρίως στη Θεσσαλονίκη και τη Βόρεια Ελλάδα. Η σωστή επιλογή ακινήτου και τοποθεσίας αποτελεί τη βάση κάθε επιτυχημένου έργου.',
      },
      {
        title: 'Ανακατασκευές & Εισοδηματικά Ακίνητα',
        description:
          'Αναπτύσσουμε και ανακατασκευάζουμε κατοικίες με στόχο τη δημιουργία αξίας και τη μελλοντική αξιοποίησή τους. Παράλληλα, διαχειριζόμαστε ακίνητα που μπορούν να προσφέρουν σταθερό εισόδημα σε βάθος χρόνου. Κάθε έργο ξεκινά μόνο όταν υπάρχει σαφές επιχειρηματικό πλάνο, προϋπολογισμός και στρατηγική εξόδου.',
      },
      {
        title: 'Συντηρητική Αποτίμηση',
        description:
          'Κάθε επένδυση αξιολογείται με ρεαλιστικές και συντηρητικές παραδοχές, όχι με υπεραισιόδοξα σενάρια. Η απόφαση λαμβάνεται μόνο όταν το έργο παραμένει οικονομικά λογικό ακόμα και σε πιο δύσκολες συνθήκες αγοράς.',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-lexi-lauwer.jpg',
      alt: 'Ανάπτυξη ακινήτων δίπλα στη θάλασσα στην Ελλάδα — QBEE',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#EAE5DC] dark:bg-[#162438]"></div>
    </Fragment>
  </Content>

  <!-- ── Τομέας 2: Στρατηγικές Συμμετοχές ── -->
  <Content
    isAfterContent
    tagline="Τομέας 2"
    title="Στρατηγικές Συμμετοχές"
    items={[
      {
        title: 'Επιλεκτική Προσέγγιση',
        description:
          'Δεν αναζητούμε συμμετοχές μόνο για να διευρύνουμε το αντικείμενό μας. Μας ενδιαφέρουν εταιρίες με ξεκάθαρο μοντέλο λειτουργίας, αξιόπιστη διοίκηση και προοπτική ανάπτυξης σε βάθος χρόνου. Κάθε συμμετοχή εξετάζεται με προσοχή και μόνο όταν υπάρχει πραγματικός λόγος δέσμευσης κεφαλαίου.',
      },
      {
        title: 'Κριτήρια Αξιολόγησης',
        description:
          'Κάθε ευκαιρία αξιολογείται με βάση την ποιότητα της διοίκησης, τη θέση της εταιρίας στην αγορά, το ανταγωνιστικό της πλεονέκτημα και την ικανότητά της να παράγει ελεύθερες ταμειακές ροές. Παράλληλα, εξετάζεται από την αρχή η δυνατότητα μελλοντικής εξόδου σε εύλογο χρονικό ορίζοντα.',
      },
      {
        title: 'Μειοψηφικές ή Πλειοψηφικές Συμμετοχές',
        description:
          'Ανάλογα με τη φύση της επένδυσης, εξετάζουμε τόσο μειοψηφικές συμμετοχές με ενεργό ρόλο στη στρατηγική κατεύθυνση, όσο και πλειοψηφικές θέσεις όταν η ουσιαστική λειτουργική εμπλοκή μπορεί να προσθέσει αξία. Η μορφή της συμμετοχής αποφασίζεται με βάση το κάθε deal, τη δυναμική της εταιρίας και τον ρόλο που μπορούμε να έχουμε στην ανάπτυξή της.',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-photo-3183197.jpg',
      alt: 'Στρατηγικές επιχειρηματικές συνεργασίες — QBEE',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#EAE5DC] dark:bg-[#162438]"></div>
    </Fragment>
  </Content>

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ας μιλήσουμε',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">Έχετε μια ευκαιρία που αξίζει να συζητηθεί;</Fragment>
    <Fragment slot="subtitle">
      Αν υπάρχει ξεκάθαρη δομή, αξιόπιστη ομάδα και προοπτική ουσιαστικής ανάπτυξης, μπορούμε να εξετάσουμε τη
      δυνατότητα συνεργασίας.
    </Fragment>
  </CallToAction>
</Layout>
