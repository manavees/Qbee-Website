---
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Σχετικά με τη QBEE',
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    tagline="Εταιρία"
    image={{
      src: '~/assets/images/pexels-photo-3183197.jpg',
      alt: 'QBEE — επαγγελματική συνάντηση',
    }}
  >
    <Fragment slot="title">
      Σχετικά με τη <span class="text-primary">QBEE</span>
    </Fragment>

    <Fragment slot="subtitle">
      Ανάπτυξη ακινήτων με μελέτη και συνέπεια — χωρίς υποσχέσεις εγγυημένης απόδοσης.
    </Fragment>
  </Hero>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Τομείς Δραστηριότητας', amount: '2' },
      { title: 'Έτος Ίδρυσης', amount: '2026' },
      { title: 'Έδρα', amount: 'Θεσσαλονίκη' },
      { title: 'Ίδια Κεφάλαια', amount: '100%' },
    ]}
  />

  <!-- Η Λογική πίσω από τη Δομή -->
  <Content
    isReversed
    tagline="Φιλοσοφία"
    title="Η Λογική πίσω από τη Δομή"
    items={[
      {
        title: 'Μελέτη πριν την υπόσχεση',
        description:
          'Δεν χρεώνουμε ένα ακίνητο ή μια συμμετοχή με προσδοκίες που δεν στηρίζονται σε στοιχεία. Κάθε ισχυρισμός για ποιότητα ή απόδοση περνά πρώτα από μελέτη — και δεν υποσχόμαστε ποτέ εγγυημένη απόδοση.',
      },
      {
        title: 'Ορίζοντας σε χρόνια',
        description:
          'Ο ορίζοντας των έργων μας μετριέται σε χρόνια, όχι σε τρίμηνα. Η ανάλυση γίνεται πριν την επένδυση — όχι μετά, για να δικαιολογηθεί.',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-photo-59002.jpg',
      alt: 'Ανάλυση επενδυτικής στρατηγικής — QBEE',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#EAE5DC] dark:bg-[#162438]"></div>
    </Fragment>
  </Content>

  <!-- Τι μας ενδιαφέρει -->
  <Steps2
    title="Τι μας ενδιαφέρει"
    subtitle="Δεν μας ενδιαφέρει να είμαστε παντού. Μας ενδιαφέρουν τομείς που η γνώση της αγοράς μετράει περισσότερο από την τύχη."
    items={[
      {
        title: 'Ακίνητα που αναπτύσσουμε οι ίδιοι',
        description:
          'Ακίνητα που αναπτύσσουμε και διαχειριζόμαστε οι ίδιοι, από την αγορά του οικοπέδου έως την αξιοποίησή του.',
      },
      {
        title: 'Δομή πριν ξεκινήσει το έργο',
        description:
          'Σε κάθε περίπτωση, η δομή ορίζεται πριν ξεκινήσει το έργο — χρηματοδότηση, κατανομή κινδύνου, στρατηγική εξόδου.',
      },
      {
        title: 'Επιλεκτικές συμμετοχές',
        description:
          'Συμμετέχουμε επιλεκτικά σε εταιρίες εκτός του κύριου αντικειμένου μας, όταν η δομή, η διοίκηση και οι προοπτικές δικαιολογούν μακροπρόθεσμη δέσμευση.',
      },
    ]}
  />

  <!-- Γεωγραφία & Εστίαση -->
  <Content
    isAfterContent
    tagline="Τοποθεσία"
    title="Γεωγραφία & Εστίαση"
    items={[
      {
        title: 'Βάση στη Θεσσαλονίκη',
        description:
          'Η έδρα μας είναι η Θεσσαλονίκη και η Βόρεια Ελλάδα. Δεν αποκλείουμε ευκαιρίες αλλού, αλλά επενδύουμε με μεγαλύτερη πεποίθηση εκεί που γνωρίζουμε την αγορά από κοντά.',
      },
      {
        title: 'Ευελιξία εκτός έδρας',
        description:
          'Για στρατηγικές συμμετοχές, η γεωγραφία παίζει μικρότερο ρόλο — αξιολογούμε την ευκαιρία ανεξαρτήτως τοποθεσίας.',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-palocech-286744.jpg',
      alt: 'QBEE — έδρα Θεσσαλονίκη, ανάπτυξη ακινήτων Βόρεια Ελλάδα',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#EAE5DC] dark:bg-[#162438]"></div>
    </Fragment>
  </Content>

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Επικοινωνήστε μαζί μας',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">Επικοινωνήστε μαζί μας</Fragment>
    <Fragment slot="subtitle">
      Αν θέλετε να συζητήσουμε μια ευκαιρία συνεργασίας ή απλώς να γνωριστούμε, στείλτε μας μήνυμα.
    </Fragment>
  </CallToAction>
</Layout>
