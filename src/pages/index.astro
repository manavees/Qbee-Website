---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'QBEE — Ανάπτυξη Ακινήτων με γνώση και συνέπεια',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Τομείς Δραστηριότητας',
        href: '/sectors',
      },
      {
        text: 'Επικοινωνία',
        href: '/contact',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-palocech-286744.jpg',
      alt: 'Παραθαλάσσια οικιστική ανάπτυξη στην Ελλάδα — QBEE',
    }}
  >
    <Fragment slot="title">
      Με γνώση.<br />
      <span class="text-primary">Με συνέπεια.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Η QBEE αναπτύσσει και διαχειρίζεται ακίνητα στη Θεσσαλονίκη και τη Βόρεια Ελλάδα. Κάθε έργο ξεκινά από μελέτη,
      προχωρά με ξεκάθαρη δομή και δεν υπόσχεται εγγυημένη απόδοση.
    </Fragment>
  </Hero>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Τομείς Δραστηριότητας', amount: '2' },
      { title: 'Έτος Ίδρυσης', amount: '2026' },
      { title: 'Έδρα', amount: 'Θεσσαλονίκη' },
    ]}
  />

  <!-- Τομείς Δραστηριότητας -->
  <Features
    id="tomeis"
    tagline="Τι Κάνουμε"
    title="Τομείς Δραστηριότητας"
    subtitle="Δραστηριοποιούμαστε σε δύο τομείς με κοινή φιλοσοφία: μακροπρόθεσμη αξία, ελεγχόμενος κίνδυνος και μελετημένη απόφαση."
    items={[
      {
        title: 'Ανάπτυξη & Διαχείριση Ακινήτων',
        description:
          'Αγοράζουμε οικόπεδα, αναπτύσσουμε και διαχειριζόμαστε ακίνητα που μπορούν να παράγουν σταθερό εισόδημα. Κάθε έργο αξιολογείται με συντηρητικές παραδοχές, ξεκάθαρη στρατηγική και σαφές πλάνο πριν δεσμευτεί οποιοδήποτε κεφάλαιο.',
        icon: 'tabler:building-estate',
      },
      {
        title: 'Στρατηγικές Συμμετοχές',
        description:
          'Συμμετέχουμε επιλεκτικά σε εταιρίες εκτός του κύριου αντικειμένου μας, όταν η δομή, η διοίκηση και οι προοπτικές δικαιολογούν μακροπρόθεσμη δέσμευση.',
        icon: 'tabler:users',
      },
    ]}
  />

  <!-- About / Ποιοι Είμαστε -->
  <Content
    isReversed
    tagline="Εταιρία"
    title="Ποιοι Είμαστε"
    items={[
      {
        title: 'Ανάπτυξη με μελέτη',
        description:
          'Κάθε ακίνητο που αναπτύσσουμε περνά πρώτα από μελέτη αγοράς, κόστους και ρίσκου. Δεν δεσμεύουμε κεφάλαιο σε ένα έργο πριν η ανάλυση δικαιολογεί την απόφαση.',
      },
      {
        title: 'Αποφάσεις με στοιχεία',
        description:
          'Κάθε επένδυση ξεκινά από την ίδια ερώτηση: τι επιστρέφει αυτό σε βάθος χρόνου, και ποια είναι η χειρότερη έκβαση αν κάτι δεν πάει καλά; Οι αποφάσεις παίρνονται με στοιχεία, όχι με αισιοδοξία.',
      },
      {
        title: 'Θεσσαλονίκη — γνώση της αγοράς από κοντά',
        description:
          'Η έδρα μας είναι η Θεσσαλονίκη. Δεν αποκλείουμε ευκαιρίες αλλού, αλλά επενδύουμε με μεγαλύτερη πεποίθηση εκεί που γνωρίζουμε την αγορά από κοντά.',
      },
    ]}
    image={{
      src: '~/assets/images/pexels-photo-3184291.jpg',
      alt: 'QBEE — στρατηγική συνεργασία',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Η λογική πίσω από κάθε έργο</h3>
      Δείτε τη φιλοσοφία και τον τρόπο λήψης αποφάσεών μας.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#EAE5DC] dark:bg-[#162438]"></div>
    </Fragment>
  </Content>

  <!-- CallToAction -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ας μιλήσουμε',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">Έχετε ακίνητο προς αξιοποίηση ή μια ευκαιρία που αξίζει να συζητηθεί;</Fragment>

    <Fragment slot="subtitle">
      Αν υπάρχει ξεκάθαρη δομή, αξιόπιστη ομάδα και προοπτική ουσιαστικής ανάπτυξης, μπορούμε να εξετάσουμε τη
      δυνατότητα συνεργασίας.
    </Fragment>
  </CallToAction>
</Layout>
